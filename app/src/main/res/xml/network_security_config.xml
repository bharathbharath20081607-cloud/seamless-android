<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config — Defense-in-depth:
  - Blocks cleartext HTTP globally
  - Allows cleartext only to 127.0.0.1 (Tor SOCKS proxy)
  - Certificate pinning not needed (we don't use HTTPS to our own servers)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext to localhost only (Tor SOCKS proxy) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
